// ============================================================
// Momentum — Prisma Schema
// Database: PostgreSQL (Supabase)
// Auth: Auth.js (NextAuth) compatible
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH (Auth.js / NextAuth compatible models)
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  phone         String?

  // Plan del usuario
  plan          Plan      @default(FREE)

  // Datos de facturación México (SAT)
  billingName   String?   @map("billing_name")
  billingRfc    String?   @map("billing_rfc")
  billingEmail  String?   @map("billing_email")

  // Tracking de origen (para medir CAC por canal)
  utmSource     String?   @map("utm_source")
  utmMedium     String?   @map("utm_medium")
  utmCampaign   String?   @map("utm_campaign")

  // Relaciones
  accounts     Account[]
  sessions     Session[]
  events       Event[]
  payments     Payment[]
  subscription Subscription?

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// TEMPLATES — catálogo de plantillas disponibles
// ============================================================

model Template {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  type            EventType
  description     String?
  previewImageUrl String?   @map("preview_image_url")

  // Configuración estructural del template (secciones, defaults)
  config          Json      @default("{}")

  isPremium       Boolean   @default(false) @map("is_premium")
  isActive        Boolean   @default(true) @map("is_active")
  sortOrder       Int       @default(0) @map("sort_order")

  events          Event[]

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([type, isActive])
  @@map("templates")
}

// ============================================================
// EVENTS — cada invitación que un usuario crea
// ============================================================

model Event {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  templateId String @map("template_id")

  // Info básica
  type      EventType
  title     String
  slug      String    @unique // para URL pública, ej: /e/maria-y-juan
  eventDate DateTime  @map("event_date")
  timezone  String    @default("America/Mexico_City")

  // Ubicación
  locationName    String? @map("location_name")
  locationAddress String? @map("location_address")
  locationLat     Float?  @map("location_lat")
  locationLng     Float?  @map("location_lng")
  locationUrl     String? @map("location_url") // enlace a Google Maps / Waze

  // Privacidad
  privacyMode PrivacyMode @default(UNIQUE_LINK) @map("privacy_mode")
  accessCode  String?     @map("access_code") // solo si privacyMode = CODE

  // Estado
  status      EventStatus @default(DRAFT)
  publishedAt DateTime?   @map("published_at")

  // Personalización (colores, música, dress code, hashtag, hosts, secciones)
  // Guardamos como JSON para flexibilidad sin migraciones cada cambio
  settings    Json        @default("{}")

  // Relaciones
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template  @relation(fields: [templateId], references: [id])
  guests   Guest[]
  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([slug])
  @@index([status, eventDate])
  @@map("events")
}

// ============================================================
// GUESTS — lista de invitados por evento
// ============================================================

model Guest {
  id      String @id @default(cuid())
  eventId String @map("event_id")

  fullName String  @map("full_name")
  email    String?
  phone    String?

  // Token único para link personalizado: /e/[slug]/[uniqueToken]
  uniqueToken String @unique @map("unique_token")

  maxCompanions   Int     @default(0) @map("max_companions")
  groupTag        String? @map("group_tag") // ej: "familia novia", "amigos novio"
  tableAssignment String? @map("table_assignment") // mesa asignada (opcional)

  event Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvp  Rsvp?
  views InvitationView[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventId])
  @@map("guests")
}

// ============================================================
// RSVPS — respuesta de cada invitado
// ============================================================

model Rsvp {
  id      String @id @default(cuid())
  guestId String @unique @map("guest_id")

  status              RsvpStatus @default(PENDING)
  companionsConfirmed Int        @default(0) @map("companions_confirmed")
  message             String?
  dietaryRestrictions String?    @map("dietary_restrictions")

  respondedAt DateTime? @map("responded_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("rsvps")
}

// ============================================================
// INVITATION_VIEWS — analytics: cuándo y desde dónde se abrió
// ============================================================

model InvitationView {
  id      String @id @default(cuid())
  guestId String @map("guest_id")

  ipHash    String? @map("ip_hash") // hasheado, no guardamos IP cruda
  userAgent String? @map("user_agent") @db.Text
  city      String?
  country   String?

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now()) @map("viewed_at")

  @@index([guestId])
  @@index([viewedAt])
  @@map("invitation_views")
}

// ============================================================
// PAYMENTS — cada transacción (Stripe o Mercado Pago)
// ============================================================

model Payment {
  id      String  @id @default(cuid())
  userId  String  @map("user_id")
  eventId String? @map("event_id")

  provider          PaymentProvider
  providerPaymentId String?         @unique @map("provider_payment_id")

  amountCents Int    @map("amount_cents") // en centavos para evitar floats
  currency    String @default("MXN")

  status PaymentStatus @default(PENDING)

  description String?
  metadata    Json    @default("{}")

  user  User   @relation(fields: [userId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("payments")
}

// ============================================================
// SUBSCRIPTIONS — solo para plan Pro/Business recurrente
// ============================================================

model Subscription {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  provider               PaymentProvider
  providerSubscriptionId String?         @unique @map("provider_subscription_id")

  plan   Plan
  status SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime  @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("subscriptions")
}

// ============================================================
// ENUMS
// ============================================================

enum Plan {
  FREE
  ESSENTIAL
  PREMIUM
  PRO
  BUSINESS
}

enum EventType {
  WEDDING
  QUINCEANERA
  BIRTHDAY
  BAPTISM
  CORPORATE
  PARTY
  OTHER
}

enum PrivacyMode {
  PUBLIC // cualquiera con el link entra
  UNIQUE_LINK // link único por invitado
  CODE // requiere código de acceso
}

enum EventStatus {
  DRAFT // editando, aún no pagado/publicado
  ACTIVE // publicado y visible
  FINISHED // ya pasó el evento
  ARCHIVED // el usuario lo archivó
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
  MAYBE
}

enum PaymentProvider {
  STRIPE
  MERCADOPAGO
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?     @map("email_verified")
  image         String?
  phone         String?
  plan          Plan          @default(FREE)
  billingName   String?       @map("billing_name")
  billingRfc    String?       @map("billing_rfc")
  billingEmail  String?       @map("billing_email")
  utmSource     String?       @map("utm_source")
  utmMedium     String?       @map("utm_medium")
  utmCampaign   String?       @map("utm_campaign")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  role          Role          @default(USER)
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  stripeCustomerId String?    @unique @map("stripe_customer_id")
  accounts      Account[]
  events        Event[]
  payments      Payment[]
  sessions      Session[]
  subscription  Subscription?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Template {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  type            EventType
  description     String?
  previewImageUrl String?   @map("preview_image_url")
  config          Json      @default("{}")
  isPremium       Boolean   @default(false) @map("is_premium")
  isActive        Boolean   @default(true) @map("is_active")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  events          Event[]

  @@index([type, isActive])
  @@map("templates")
}

model Event {
  id              String      @id @default(cuid())
  userId          String      @map("user_id")
  templateId      String      @map("template_id")
  type            EventType   @default(WEDDING)
  title           String
  slug            String      @unique
  eventDate       DateTime?   @map("event_date")
  timezone        String      @default("America/Mexico_City")
  locationName    String?     @map("location_name")
  locationAddress String?     @map("location_address")
  locationLat     Float?      @map("location_lat")
  locationLng     Float?      @map("location_lng")
  locationUrl     String?     @map("location_url")
  privacyMode     PrivacyMode @default(UNIQUE_LINK) @map("privacy_mode")
  accessCode      String?     @map("access_code")
  status          EventStatus @default(DRAFT)
  publishedAt     DateTime?   @map("published_at")
  settings        Json        @default("{}")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  location        String?
  coverImage      String?     @map("cover_image")
  tier            Tier        @default(ESSENTIAL)
  paymentStatus         PaymentStatus @default(UNPAID) @map("payment_status")
  stripeCheckoutId      String?       @map("stripe_checkout_id")
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  paidAt                DateTime?     @map("paid_at")
  activeUntil           DateTime?     @map("active_until")
  subscriptionId        String?       @map("subscription_id")
  clientToken           String?       @unique @map("client_token")
  clientName            String?       @map("client_name")
  clientEmail           String?       @map("client_email")
  intakeNotes           String?       @map("intake_notes")
  activeSections  Json        @default("{}") @map("active_sections")
  template        Template    @relation(fields: [templateId], references: [id])
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  guests          Guest[]
  payments        Payment[]

  @@index([userId])
  @@index([slug])
  @@index([status, eventDate])
  @@index([subscriptionId])
  @@map("events")
}

model Guest {
  id              String             @id @default(cuid())
  eventId         String             @map("event_id")
  email           String?
  phone           String?
  uniqueToken     String             @unique @map("unique_token")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  adminNotes      String?            @map("admin_notes")
  allowedGuests   Int                @default(0) @map("allowed_guests")
  invitedBy       InvitedBy?         @map("invited_by")
  name            String
  relationship    GuestRelationship?
  tableNumber     String?            @map("table_number")
  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitationViews InvitationView[]
  rsvp            Rsvp?

  @@index([eventId])
  @@index([uniqueToken])
  @@map("guests")
}

model Rsvp {
  id                  String     @id @default(cuid())
  guestId             String     @unique @map("guest_id")
  status              RsvpStatus @default(PENDING)
  message             String?
  dietaryRestrictions String?    @map("dietary_restrictions")
  respondedAt         DateTime?  @map("responded_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  confirmedGuests     Int        @default(0) @map("confirmed_guests")
  menuChoice          String?    @map("menu_choice")
  guest               Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("rsvps")
}

model InvitationView {
  id        String   @id @default(cuid())
  guestId   String   @map("guest_id")
  ipHash    String?  @map("ip_hash")
  userAgent String?  @map("user_agent")
  city      String?
  country   String?
  viewedAt  DateTime @default(now()) @map("viewed_at")
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([viewedAt])
  @@map("invitation_views")
}

model Payment {
  id                String          @id @default(cuid())
  userId            String          @map("user_id")
  eventId           String?         @map("event_id")
  provider          PaymentProvider
  providerPaymentId String?         @unique @map("provider_payment_id")
  amountCents       Int             @map("amount_cents")
  currency          String          @default("MXN")
  status            PaymentStatus   @default(UNPAID)
  description       String?
  metadata          Json            @default("{}")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  event             Event?          @relation(fields: [eventId], references: [id])
  user              User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("payments")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String             @unique @map("stripe_customer_id")
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  plan                 SubscriptionPlan
  status               SubscriptionStatus
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  events               Event[]
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@map("subscriptions")
}

model PaymentLog {
  id            String   @id @default(cuid())
  eventId       String?  @map("event_id")
  userId        String?  @map("user_id")
  stripeEventId String   @unique @map("stripe_event_id")
  type          String
  amount        Int?
  currency      String?
  rawPayload    Json     @map("raw_payload")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([eventId])
  @@index([userId])
  @@map("payment_logs")
}

enum GuestRelationship {
  FAMILY_BRIDE
  FAMILY_GROOM
  FAMILY_BIRTHDAY
  FRIEND
  WORK
  OTHER
}

enum InvitedBy {
  BRIDE
  GROOM
  BOTH
  HOST
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
  MAYBE
}

enum Role {
  ADMIN
  USER
}

enum Plan {
  FREE
  ESSENTIAL
  PREMIUM
  PRO
  BUSINESS
}

enum EventType {
  WEDDING
  XV
  BIRTHDAY
  CORPORATE
  BAPTISM
  GRADUATION
  BABY_SHOWER
  CASUAL
  OTHER
}

enum Tier {
  FREE
  EXPRESS
  ESSENTIAL
  COMPLETE
  LUXURY
}

enum PrivacyMode {
  PUBLIC
  UNIQUE_LINK
  CODE
}

enum EventStatus {
  DRAFT
  PAID
  INTAKE_COMPLETE
  BUILDING
  REVIEW
  CHANGES_REQUESTED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum PaymentProvider {
  STRIPE
  MERCADOPAGO
}

enum PaymentStatus {
  UNPAID          @map("UNPAID")
  PENDING_VOUCHER @map("PENDING_VOUCHER")
  PAID            @map("PAID")
  EXPIRED         @map("EXPIRED")
  REFUNDED        @map("REFUNDED")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

enum SubscriptionPlan {
  ORGANIZADOR_PLUS
  ORGANIZADOR_PRO
}
